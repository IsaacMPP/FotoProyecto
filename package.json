{
  "name": "demi-visor-studio",
  "version": "0.9.0",
  "private": true,
  "description": "Demi Visor Studio para Windows con conexión Canon USB y Wi-Fi",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check projector.js && node --check photo-grouping.js && node --test photo-grouping.test.js && node --test wifi-only-jpeg.test.js",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "mx.demistudios.tether",
    "productName": "Demi Visor Studio",
    "asar": true,
    "files": [
      "main.js",
      "photo-grouping.js",
      "preload.js",
      "renderer.js",
      "projector.js",
      "index.html",
      "projector.html",
      "style.css"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "camera-bridge/publish",
        "to": "camera-bridge",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "wifi-bridge/publish",
        "to": "wifi-bridge",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "bonjour-service": "1.3.0"
  }
}
